{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "num",
  "parent": "numbering",
  "addParent": "/numbering",
  "operations": { "add": true, "set": true, "get": true, "query": true, "remove": false },
  "paths": { "stable": ["/numbering/num[@id=N]"], "positional": ["/numbering/num[N]"] },
  "note": "Numbering instance referencing an existing abstractNum. New instances restart level 0 by default; pass continue=true to retain Word's continuation behavior.",
  "properties": {
    "id": { "type": "int", "add": true, "get": true, "enforcement": "strict" },
    "abstractNumId": { "type": "int", "add": true, "set": true, "get": true, "enforcement": "strict" },
    "start": { "type": "int", "add": true, "set": true, "get": false, "enforcement": "strict", "description": "Shorthand for startOverride.0." },
    "startOverride.N": { "type": "int", "add": true, "set": true, "get": true, "enforcement": "strict", "description": "Per-level start override; N must be 0 through 8." },
    "continue": { "type": "boolean", "add": true, "set": false, "get": false, "enforcement": "strict", "description": "Do not add the default level-0 restart override." }
  }
}
